NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/data/moapp.sqlite
# Required in production: exact public http(s) origin, without a path.
APP_ORIGIN=https://moapp.example
# Transitional legacy-claim PIN. Omit after the legacy claim is closed.
APP_PIN=change-me-for-legacy-cutover
# At least 32 characters; `openssl rand -hex 32` produces a suitable value.
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
# Keep independent from SESSION_SECRET so session rotation does not break integrations.
INTEGRATION_ENCRYPTION_KEY=change-me-to-another-long-random-secret
# Development only: point the integration to `npm run dev:bybit-mock`.
# BYBIT_API_BASE_URL=http://127.0.0.1:4010
SESSION_TTL_DAYS=30
INVITATION_TTL_HOURS=72
MAX_ACTIVE_INVITATIONS=20
DEVICE_LINK_TTL_MINUTES=15
RECOVERY_ROTATION_TTL_MINUTES=30
LEGACY_CLAIM_TTL_MINUTES=30
ACCESS_PREVIEW_RATE_LIMIT_PER_MINUTE=20
INVITATION_RATE_LIMIT_PER_HOUR=10
DEVICE_LINK_RATE_LIMIT_PER_HOUR=5
RECOVERY_PREPARE_RATE_LIMIT_PER_15_MINUTES=5
MANUAL_RECOVERY_RATE_LIMIT_PER_HOUR=3
FRANKFURTER_URL=https://api.frankfurter.dev/v2
DEFAULT_ANALYTICS_CURRENCY=RSD
