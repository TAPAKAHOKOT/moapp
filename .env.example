# Image produced by the GitHub Actions workflow.
APP_IMAGE=ghcr.io/your-github-user/moapp:latest

# Public application settings.
APP_HOST_PORT=8892
# Required in production. Use the exact public http(s) origin without a path.
APP_ORIGIN=https://moapp.tapakahokot.com
TZ=Europe/Belgrade

# Keep these values only in /opt/moapp/.env on the VPS.
# Transitional legacy-claim PIN. Required only while an upgraded database has
# an open/pending legacy claim; remove it after recovery closes that claim.
APP_PIN=replace-with-a-long-pin
# At least 32 characters. Rotating it invalidates all signed session cookies.
SESSION_SECRET=replace-with-at-least-32-random-characters
# Independent key for encrypting Bybit API credentials stored in SQLite.
INTEGRATION_ENCRYPTION_KEY=replace-with-another-at-least-32-character-secret
SESSION_TTL_DAYS=30

# Access-link lifetimes and abuse limits.
INVITATION_TTL_HOURS=72
MAX_ACTIVE_INVITATIONS=20
DEVICE_LINK_TTL_MINUTES=15
RECOVERY_ROTATION_TTL_MINUTES=30
LEGACY_CLAIM_TTL_MINUTES=30
ACCESS_PREVIEW_RATE_LIMIT_PER_MINUTE=20
INVITATION_RATE_LIMIT_PER_HOUR=10
DEVICE_LINK_RATE_LIMIT_PER_HOUR=5
RECOVERY_PREPARE_RATE_LIMIT_PER_15_MINUTES=5
MANUAL_RECOVERY_RATE_LIMIT_PER_HOUR=3

# Application defaults.
DEFAULT_ANALYTICS_CURRENCY=RSD
FRANKFURTER_URL=https://api.frankfurter.dev/v2

# Private Cloudflare R2 bucket credentials. Create a token scoped to this bucket.
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_BUCKET=moapp-backups
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_REPLICA_PATH=production/moapp.sqlite
