NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_PATH=/data/moapp.sqlite
# Shared PIN. Keep this only in the VPS/GitHub secret, never in git.
APP_PIN=change-me
# At least 32 random bytes, for example: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
SESSION_TTL_DAYS=30
FRANKFURTER_URL=https://api.frankfurter.dev/v2
DEFAULT_ANALYTICS_CURRENCY=RSD
